# Copy to .env.local for local development. Never commit real secrets.

# Optional. Leave blank to run the zero-config demo store.
# With a value, bookings are stored in MongoDB Atlas. The database must be a
# replica set (Atlas always is).
MONGODB_URI=
MONGODB_DB=palmyrah

# Public origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "false" for a launch build. When unset, the site runs in prototype
# mode: noindex, visible prototype labels and demo content.
NEXT_PUBLIC_PROTOTYPE_MODE=true

# Signs guest booking links. Use a long random value in production
# (for example: openssl rand -base64 48).
BOOKING_LINK_SECRET=

# Optional. A Google Maps embed URL for the contact page. Without it, the
# page shows a designed location panel instead of an iframe.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
